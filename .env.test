# Overrides applied on top of .env when running integration tests
# (test/jest.setup.ts loads .env first, then this file with override:true).
# Points at a dedicated test database so integration tests never touch
# development data, and can freely create/drop rows between runs.
DATABASE_URL=postgresql://reconciliation_user:reconciliation_password@localhost:5435/reconciliation_system_test?schema=public
JWT_SECRET=test-secret-for-integration-tests-only
JWT_EXPIRES_IN=1d
