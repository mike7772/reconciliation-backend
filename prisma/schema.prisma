// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user")
}

enum ImportStatus {
  pending
  processing
  completed
  failed
  cancelling
  cancelled
}

enum RiskLevel {
  low
  medium
  high
}

// Authoritative source of truth for import status/progress. BullMQ (Phase 3)
// only dispatches processing; this row is what the REST API reads from and
// what makes progress/cancellation/recovery consistent across restarts.
model Import {
  id               String       @id @default(uuid())
  idempotencyKey   String       @unique
  providerId       String
  status           ImportStatus @default(pending)

  processedCount   Int          @default(0)
  acceptedCount    Int          @default(0)
  rejectedCount    Int          @default(0)
  duplicateCount   Int          @default(0)

  // Byte offset into the stored file up to which processing has been
  // durably committed, enabling resume-from-checkpoint via MinIO ranged
  // GETs instead of reprocessing already-committed bytes after a retry.
  checkpointOffset BigInt       @default(0)

  cancelRequested  Boolean      @default(false)
  failureReason    String?

  createdAt        DateTime     @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  uploadedFile     UploadedFile?
  transactions     Transaction[]
  rejectedRecords  RejectedRecord[]

  @@index([status])
  @@map("import")
}

model UploadedFile {
  id               String   @id @default(uuid())
  importId         String   @unique
  import           Import   @relation(fields: [importId], references: [id], onDelete: Cascade)

  storageBucket    String
  storageKey       String
  sizeBytes        BigInt
  checksum         String
  originalFilename String
  mimeType         String

  createdAt        DateTime @default(now())

  @@map("uploaded_file")
}

// Accepted transactions. The (providerId, transactionId) unique constraint
// is the actual duplicate-detection mechanism - enforced by the database,
// not an in-memory set, so it holds across processes, restarts, and
// concurrent imports.
model Transaction {
  id            String    @id @default(uuid())
  importId      String
  import        Import    @relation(fields: [importId], references: [id], onDelete: Cascade)

  providerId    String
  transactionId String
  accountId     String
  merchantId    String
  amount        Decimal   @db.Decimal(18, 2)
  currency      String
  timestamp     DateTime
  description   String?

  fingerprint   String
  riskScore     Int
  riskLevel     RiskLevel

  createdAt     DateTime  @default(now())

  @@unique([providerId, transactionId])
  @@index([importId])
  @@index([currency])
  @@index([riskLevel])
  @@index([merchantId])
  @@index([accountId])
  @@map("transaction")
}

model RejectedRecord {
  id         String   @id @default(uuid())
  importId   String
  import     Import   @relation(fields: [importId], references: [id], onDelete: Cascade)

  lineNumber Int
  reasonCode String
  message    String
  // Size-capped at the application layer before insert - never persist an
  // unbounded malformed payload.
  rawValue   Json?

  createdAt  DateTime @default(now())

  @@index([importId, lineNumber])
  @@map("rejected_record")
}