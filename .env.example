# App
PORT=4000
NODE_ENV=dev
RATE_LIMIT_TIME=100
RATE_LIMIT_REQUEST=100

# Imports
# Max NDJSON upload size in bytes (default 2GB)
MAX_UPLOAD_BYTES=2147483648
# Max imports the worker processes simultaneously (bounded concurrency)
MAX_CONCURRENT_IMPORTS=2
# Retry policy for transient DB errors during batch commits
DB_RETRY_MAX_ATTEMPTS=4
DB_RETRY_BASE_DELAY_MS=100
DB_RETRY_MAX_DELAY_MS=2000
# Worker's own Prometheus scrape port (separate process/registry from the API)
WORKER_METRICS_PORT=9465
# Max time graceful shutdown waits before forcing exit
SHUTDOWN_GRACE_PERIOD_MS=30000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# BullMQ dashboard (/admin/queues) - HTTP Basic Auth, not the JWT bearer
# scheme, since this is a browser-navigated page rather than an API call
ADMIN_DASHBOARD_USER=admin
ADMIN_DASHBOARD_PASSWORD=password

# Postgres / Prisma
POSTGRES_USER=reconciliation_user
POSTGRES_PASSWORD=reconciliation_password
POSTGRES_DB=reconciliation_system
POSTGRES_PORT=5435
DATABASE_URL=postgresql://reconciliation_user:reconciliation_password@localhost:5435/reconciliation_system?schema=public

# Redis
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# MinIO (used when NODE_ENV != production - see src/config/objectStorage.ts)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reconciliation-system

# Cloudflare R2 (used only when NODE_ENV=production - same FileStorage
# adapter, different S3-compatible endpoint/credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reconciliation-system
R2_PUBLIC_URL=
