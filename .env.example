# App
PORT=4000
NODE_ENV=dev
RATE_LIMIT_TIME=100
RATE_LIMIT_REQUEST=100

# Imports
# Max NDJSON upload size in bytes (default 2GB)
MAX_UPLOAD_BYTES=2147483648

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Postgres / Prisma
POSTGRES_USER=reconciliation_user
POSTGRES_PASSWORD=reconciliation_password
POSTGRES_DB=reconciliation_system
POSTGRES_PORT=5435
DATABASE_URL=postgresql://reconciliation_user:reconciliation_password@localhost:5435/reconciliation_system?schema=public

# Redis
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reconciliation-system
