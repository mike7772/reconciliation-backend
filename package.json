{
  "name": "reconciliation-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "npx ts-node --transpile-only server.ts",
    "dev": "concurrently \"npm:watch\" \"npm:serve\" \"npm:serve:worker\"",
    "serve": "nodemon server.ts",
    "serve:worker": "nodemon worker.ts",
    "migrate:dev": "prisma migrate dev --name init",
    "watch": "npx tsc -w",
    "transpile": "npx tsc",
    "lint": "tslint -c tslint.json -p tsconfig.json",
    "test": "jest --testPathPatterns=test/unit",
    "test:unit": "jest --testPathPatterns=test/unit",
    "pretest:integration": "ts-node --transpile-only test/setupTestDb.ts",
    "test:integration": "jest --testPathPatterns=test/integration --runInBand",
    "pretest:all": "ts-node --transpile-only test/setupTestDb.ts",
    "test:all": "jest --runInBand",
    "generate:data": "ts-node --transpile-only test/load/generateData.ts",
    "benchmark": "ts-node --transpile-only test/load/benchmark.ts"
  },
  "keywords": [],
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@bull-board/api": "^8.3.0",
    "@bull-board/express": "^8.3.0",
    "@prisma/client": "^5.9.1",
    "@types/multer": "^1.4.11",
    "@types/swagger-ui-express": "^4.1.6",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "bullmq": "^5.81.2",
    "busboy": "^1.6.0",
    "compression": "^1.7.4",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "piscina": "^5.3.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.13",
    "socket.io": "^4.7.4",
    "swagger-ui-express": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "nodemon": "^3.0.3",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} ./prisma/seed.ts",
    "schema": "./prisma/schema.prisma"
  },
  "author": "Michael Asnake",
  "license": "ISC"
}
